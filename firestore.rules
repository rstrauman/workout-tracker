rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidUserDoc(data) {
      return data.keys().hasOnly([
               'email', 'createdAt', 'updatedAt', 'isProfileComplete',
               'firstName', 'lastName', 'weight', 'height', 'tel', 'goal', 'activityLevel', 'unitSystem', 'photoURL', 'targetWeight'
             ])
             && data.email == request.auth.token.email
             && data.isProfileComplete is bool
             && (!('createdAt' in data) || data.createdAt is timestamp)
             && (!('updatedAt' in data) || data.updatedAt is timestamp)
             && (!('firstName' in data) || data.firstName is string)
             && (!('lastName' in data) || data.lastName is string)
             && (!('weight' in data) || data.weight is number)
             && (!('height' in data) || data.height is number)
             && (!('tel' in data) || data.tel is string)
             && (!('goal' in data) || data.goal is string)
             && (!('activityLevel' in data) || data.activityLevel is string)
             && (!('unitSystem' in data) || data.unitSystem in ['imperial', 'metric'])
             && (!('photoURL' in data) || data.photoURL is string)
             && (!('targetWeight' in data) || data.targetWeight is number);
    }

    function isValidWorkout(data) {
      return data.keys().hasOnly(['date', 'durationSeconds', 'exercises'])
             && data.date is timestamp
             && data.durationSeconds is number
             && data.exercises is list;
    }

    function isValidTemplate(data) {
      return data.keys().hasOnly(['name', 'exercises', 'createdAt'])
             && data.name is string
             && data.exercises is list
             && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidWeightLog(data) {
      return data.keys().hasOnly(['weightLbs', 'loggedAt'])
             && data.weightLbs is number
             && data.loggedAt is timestamp;
    }

    function isValidStrengthGoal(data) {
      return data.keys().hasOnly(['exerciseName', 'targetWeightLbs', 'targetReps', 'createdAt'])
             && data.exerciseName is string
             && data.targetWeightLbs is number
             && data.targetReps is number
             && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserDoc(request.resource.data);

      match /workouts/{workoutId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWorkout(request.resource.data);
      }

      match /templates/{templateId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTemplate(request.resource.data);
      }

      match /weightLogs/{logId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWeightLog(request.resource.data);
      }

      match /strengthGoals/{goalId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidStrengthGoal(request.resource.data);
      }
    }
  }
}
